{
  "expo": {
    "name": "PocketCommute",
    "slug": "PocketCommute",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pocketcommute",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pocketcommute.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
